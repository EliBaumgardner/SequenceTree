{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/claude-md-hook.sh\"",
            "timeout": 20,
            "statusMessage": "Re-reading CLAUDE.md rules"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/refactor-gate.sh\"",
            "timeout": 15,
            "statusMessage": "Checking for hand-run extract/inline"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/systematic-check.sh\" --hook pre-edit",
            "timeout": 15,
            "statusMessage": "Front-half pass gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/design-rules.sh\" --hook post-tool",
            "timeout": 15,
            "statusMessage": "Checking design rules"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/readability.sh\" --hook post-tool",
            "timeout": 15,
            "statusMessage": "Checking readability"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/design-rules.sh\" --hook stop",
            "timeout": 20,
            "statusMessage": "Design-rule gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/readability.sh\" --hook stop",
            "timeout": 20,
            "statusMessage": "Readability gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/systematic-check.sh\" --hook stop",
            "timeout": 150,
            "statusMessage": "Systematic-pass gate"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/source-lines.sh\"",
            "timeout": 10,
            "statusMessage": "Counting Source/ lines"
          }
        ]
      }
    ]
  }
}
